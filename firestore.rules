rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuarios: cada usuario puede leer y escribir solo su propio documento
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Direcciones guardadas del usuario
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Colecciones de productos (lectura pública)
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Solo escritura via Admin SDK
    }

    // Carrito: cada usuario puede leer y escribir solo su propio carrito
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    // Promociones (lectura pública para banners y validación)
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if false; // Solo escritura via Admin SDK

      match /usages/{usageId} {
        allow read, write: if false; // Solo via Admin SDK
      }
    }

    // Pedidos/órdenes
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false; // Solo via Admin SDK
      allow delete: if false;
    }
  }
}
