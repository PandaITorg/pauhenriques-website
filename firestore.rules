rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuarios: cada usuario puede leer y escribir solo su propio documento
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Direcciones guardadas del usuario
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Colecciones de productos (lectura pública)
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Solo escritura via Admin SDK
    }

    // Talleres / cursos (dominio separado de products).
    // Lectura pública para renderizar la página del link de pago.
    // Escritura solo via Admin SDK (APIs /api/admin/talleres).
    match /talleres/{tallerId} {
      allow read: if true;
      allow write: if false;
    }

    // Homepage — Hero slides (lectura pública)
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if false; // Solo via Admin SDK
    }

    // Homepage — Categorías Carico (lectura pública)
    match /carico_categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Solo via Admin SDK
    }

    // Homepage — Productos destacados (lectura pública)
    match /featured_products/{featuredId} {
      allow read: if true;
      allow write: if false; // Solo via Admin SDK
    }

    // Carrito: cada usuario puede leer y escribir solo su propio carrito
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    // Promociones (lectura pública para banners y validación)
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if false; // Solo escritura via Admin SDK

      match /usages/{usageId} {
        allow read, write: if false; // Solo via Admin SDK
      }
    }

    // Pedidos/órdenes
    // Validación de montos exacta la hace /api/payment/charge contra el
    // precio dinámico (auto-discounts). Acá solo rango sanity para
    // bloquear órdenes con totales absurdos desde el cliente.
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.total is number
        && request.resource.data.total >= 1
        && request.resource.data.total <= 10000;
      allow update: if false; // Solo via Admin SDK
      allow delete: if false;
    }

    // Inscripciones a cursos en línea — solo admin lee, escritura via Admin SDK
    match /courseEnrollments/{enrollmentId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false; // Solo via Admin SDK (creación en charge.ts, update en admin)
    }

    // Rate limiting store — solo via Admin SDK, cliente sin acceso.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Plan Novios — registro de bodas
    match /planNovios/{planId} {
      // LECTURA — solo el dueño del plan.
      // La página pública (/plan-novios/[slug]) NO lee Firestore: pasa por
      // /api/plan-novios/[slug], que usa Admin SDK y devuelve únicamente datos
      // no financieros (nombres, fecha, mensaje, % de avance). Con `if true`
      // aquí, ese cuidado era inútil: cualquiera podía leer el documento crudo
      // —balance, totalContributed, goalAmount, userEmail— e incluso listar
      // todos los planes del sitio.
      // getPlanByUserId() sigue funcionando: su query filtra por userId, que es
      // justo lo que esta regla exige.
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // CREACIÓN — el plan tiene que ser suyo y arrancar en cero.
      // Antes bastaba con estar autenticado: se podía crear un plan a nombre de
      // otro usuario, o nacido con saldo.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.totalContributed == 0
        && request.resource.data.totalRedeemed == 0
        && request.resource.data.balance == 0;

      // EDICIÓN — el dueño cambia la presentación, nunca el dinero ni la identidad.
      // Antes podía escribir CUALQUIER campo del documento, incluido `balance`:
      // inflarlo desde el navegador y canjear productos sin haber recibido un
      // solo aporte. Los saldos los mueve exclusivamente el Admin SDK desde el
      // flujo de pago (FieldValue.increment en /api/plan-novios/contribute).
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.totalContributed == resource.data.totalContributed
        && request.resource.data.totalRedeemed == resource.data.totalRedeemed
        && request.resource.data.balance == resource.data.balance;

      allow delete: if false;

      // Contribuciones — solo lectura por el dueño del plan, escritura via Admin SDK
      match /contributions/{contributionId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/planNovios/$(planId)).data.userId;
        allow write: if false; // Solo via Admin SDK (pagos server-side)
      }

      // Canjes — solo lectura por el dueño del plan, escritura via Admin SDK
      match /redemptions/{redemptionId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/planNovios/$(planId)).data.userId;
        allow write: if false; // Solo via Admin SDK (admin registra canjes)
      }
    }
  }
}
